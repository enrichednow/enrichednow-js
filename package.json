{
  "name": "enrichednow",
  "version": "0.3.0",
  "description": "The official JavaScript and TypeScript library for the EnrichedNow API",
  "license": "MIT",
  "author": "EnrichedNow",
  "homepage": "https://docs.enrichednow.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enrichednow/enrichednow-js.git"
  },
  "bugs": {
    "url": "https://github.com/enrichednow/enrichednow-js/issues"
  },
  "keywords": [
    "enrichednow",
    "api",
    "sdk",
    "scraper",
    "jobs",
    "datasets",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke-esm.mjs && node scripts/smoke-cjs.cjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
